# Keep this file private. Put actual values in your host's Environment settings.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_RESULTS_CHANNEL_ID=
# Optional: Discord role ID allowed to use /tier-remove. Server Administrators are also allowed.
DISCORD_ADMIN_ROLE_ID=
# Supabase project URL and service_role key. NEVER put these in public/frontend files.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Number of recent messages to scan on startup (max 1000); set 0 to disable history import.
SYNC_HISTORY_LIMIT=500
PORT=3000
